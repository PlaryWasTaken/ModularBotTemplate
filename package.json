{
  "name": "bot-template",
  "version": "1.0.0",
  "description": "",
  "main": "index.ts",
  "type": "commonjs",
  "scripts": {
    "startDev": "ts-node index.ts",
    "start": "npm run build && cd dist && node index.js",
    "generate:user-augments": "node scripts/generate-user-augments.mjs",
    "build": "npm run generate:user-augments && npm i && rm -rf dist/* && tsc",
    "buildCoolify": "rm modules/* -r && npm run build",
    "postbuild": "copyfiles **/*.json **/*.txt .env -e *.json dist && del-cli \"dist/node_modules\" \"dist/dist\" \"dist/web\"",
    "postinstall": "node scripts/postinstall.mjs"
  },
  "author": "Plary",
  "license": "ISC",
  "dependencies": {
    "@slime/stopwatch": "^1.2.2",
    "async-lock": "^1.4.1",
    "axios": "1.15.0",
    "chalk": "^4",
    "copyfiles": "^2.4.1",
    "decoders": "^2.0.3",
    "del-cli": "^5.0.0",
    "discord.js": "^14.26.4",
    "dotenv": "^16.0.0",
    "fs-extra": "^11.2.0",
    "fuse.js": "^6.6.2",
    "mongoose": "9.6.1",
    "mongoose-autopopulate": "^1.2.1",
    "pupa": "^2.1.1",
    "rxjs": "^7.8.2",
    "sharp": "^0.32.0",
    "snowflakify": "^1.0.5",
    "typescript": "^7.0.2",
    "winston": "^3.8.2",
    "fuzzysort": "^3.1.0",
    "yaml": "2.8.3"
  },
  "devDependencies": {
    "@types/async-lock": "^1.4.2",
    "@types/culori": "^2.1.1",
    "@types/fs-extra": "^11.0.4",
    "@types/node": "^18.11.18",
    "ts-node": "^10.9.1"
  },
  "workspaces": {
    "packages": []
  }
}
